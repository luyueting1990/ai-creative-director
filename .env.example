# Copy to .env.local for local development. Never commit real keys.

# Enables "Live · Claude" mode. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: live generations allowed per IP per hour (default: 10).
# LIVE_RATE_LIMIT_PER_HOUR=10
